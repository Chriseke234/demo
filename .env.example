# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Provider Configuration (Gemini or OpenAI API Key)
# The application uses a modular AI concierge. You can supply either GEMINI_API_KEY or OPENAI_API_KEY.
# If both are absent, the application will run in local demo fallback mock-concierge mode.
AI_API_KEY=your_ai_api_key_here

# WhatsApp Configuration (International format without '+' or spaces, e.g. 971501234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=1234567890
